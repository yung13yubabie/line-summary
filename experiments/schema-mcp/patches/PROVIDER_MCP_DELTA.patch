new file mode 100644
--- /dev/null
+++ b/configured_child.py
@@ -0,0 +1,132 @@
+"""Fixed configured-source schema worker. Private input arrives only on its start pipe."""
+import argparse,json,os,re,sys,threading,time,hashlib
+from pathlib import Path,PureWindowsPath
+
+def explicit_local_file(value,suffix=None):
+    """Pure lexical policy shared by start ingress and the configured provider."""
+    if (type(value) is not str or not value or len(value)>2048
+            or any(ord(char)<32 for char in value)):
+        return False
+    path=PureWindowsPath(value)
+    if (not path.is_absolute() or re.fullmatch(r'[a-zA-Z]:',path.drive) is None
+            or '..' in path.parts or any(':' in part or part.endswith((' ','.'))
+                or any(char in part for char in '<>"|?*')
+                or PureWindowsPath(part).is_reserved() for part in path.parts[1:])):
+        return False
+    return suffix is None or path.suffix.casefold()==suffix
+
+def _unique_fields(pairs):
+    value={}
+    for key,item in pairs:
+        if key in value:raise ValueError('duplicate configured start field')
+        value[key]=item
+    return value
+
+def read_start(stream):
+    raw=stream.readline(4097)
+    if not raw or len(raw)>4096 or not raw.endswith(b'\n'):
+        raise ValueError('bounded configured start required')
+    try:value=json.loads(raw,object_pairs_hook=_unique_fields)
+    except (ValueError,UnicodeError):raise ValueError('configured start rejected') from None
+    if (not isinstance(value,dict) or set(value)!={'op','settings_path'} or value['op']!='start'
+            or type(value['settings_path']) is not str):
+        raise ValueError('configured start rejected')
+    path=value['settings_path']
+    if not explicit_local_file(path):
+        raise ValueError('configured start rejected')
+    return path
+
+def main():
+    parser=argparse.ArgumentParser()
+    parser.add_argument('--case',required=True);parser.add_argument('--resource',required=True)
+    parser.add_argument('--run-id',required=True);parser.add_argument('--deadline',type=float,required=True)
+    args=parser.parse_args();directory=Path(args.resource).resolve().parent
+    try:settings_path=read_start(sys.stdin.buffer)
+    except ValueError:
+        print('{"event":"cleanup_ack","resource_opened":false,"resources_closed":true}',flush=True)
+        return 3
+    protocol=os.dup(1)
+    with open(os.devnull,'wb') as sink:
+        os.dup2(sink.fileno(),1);os.dup2(sink.fileno(),2)
+    def emit(value):
+        raw=json.dumps(value,separators=(',',':')).encode()+b'\n'
+        if len(raw)>8192:raise ValueError('bounded protocol')
+        os.write(protocol,raw)
+    def audit(event,values):
+        if event in ('socket.connect','socket.bind','os.system','os.kill'):
+            raise RuntimeError('offline configured schema')
+    sys.addaudithook(audit)
+    sys.path.insert(0,str(Path(__file__).resolve().parent))
+    from schema_entry import _in_owned_job
+    from schema_probe import SchemaProbe,error_kind
+    from source_provider import ConfiguredSourceProvider,_kind
+    from extraction_budget import ExtractionBudget,ExtractionStopped
+    if args.case!='success' or not _in_owned_job():
+        raise RuntimeError('trusted configured owner required')
+    (directory/'configured_backend_started.json').write_text(json.dumps({
+        'run_id':args.run_id,'after_start':True,'in_job':True,'source_kind':'configured'}),encoding='utf-8')
+    provider=ConfiguredSourceProvider();probe=SchemaProbe()
+    stop=threading.Event();done=threading.Event();control_errors=[]
+    def control():
+        try:
+            while sys.stdin.buffer.readline(4096):
+                if not done.is_set():
+                    stop.set()
+                    for owner in (provider,probe):
+                        try:owner.cancel()
+                        except BaseException:control_errors.append('owned_cancel_failed')
+            if not done.is_set():
+                stop.set()
+                for owner in (provider,probe):
+                    try:owner.cancel()
+                    except BaseException:control_errors.append('owned_cancel_failed')
+        except BaseException:control_errors.append('owned_control_failed');stop.set()
+    controller=threading.Thread(target=control,name='configured-control',daemon=False)
+    controller.start()
+    status='failed';kind=None;counts=None;source=None
+    def stage(name,event):emit({'event':'stage_'+event,'stage':name})
+    try:
+        remaining=args.deadline-time.monotonic()
+        if remaining<=0:raise ExtractionStopped('deadline','preflight')
+        budget=ExtractionBudget(remaining,stop.is_set);budget.deadline=min(budget.deadline,args.deadline)
+        stage('source_prepare','enter')
+        source=provider.prepare(settings_path,budget)
+        stage('source_prepare','exit')
+        counts=probe.run(source.db_path,source.key,budget,stage=stage)
+        if provider.state['preparation_release_confirmed'] is not True:
+            raise RuntimeError('source preparation cleanup unconfirmed')
+        value={'run_id':args.run_id,'counts':counts,'application_ack':probe.state['application_ack'],
+            'release_evidence':probe.state['release_evidence'],'source_kind':'configured',
+            'key_preparation_cleanup_confirmed':True}
+        raw=json.dumps(value,separators=(',',':')).encode()
+        with (directory/'schema_result.json').open('wb') as handle:
+            handle.write(raw);handle.flush();os.fsync(handle.fileno())
+        with (directory/'schema_result.commit.json').open('w',encoding='utf-8') as handle:
+            json.dump({'run_id':args.run_id,'payload_sha256':hashlib.sha256(raw).hexdigest()},handle)
+            handle.flush();os.fsync(handle.fileno())
+        status='completed'
+    except BaseException as error:
+        kind=_kind(error)
+        status='cancelled' if stop.is_set() or isinstance(error,ExtractionStopped) else 'failed'
+        counts=None
+        emit({'event':'error','error_type':kind})
+    finally:
+        source=None;settings_path=None
+        try:preparation_clean=provider.close() is True
+        except BaseException as error:preparation_clean=False;kind=kind or _kind(error)
+        probe_clean=(not probe.state['source_attempted'] or probe.state['application_ack'] is True)
+        done.set();emit({'event':'result','status':status});emit({'event':'cleanup_ready'})
+        controller.join(timeout=1)
+        acknowledged=preparation_clean and probe_clean and not controller.is_alive() and not control_errors
+        observation={'run_id':args.run_id,'status':status,'error_kind':kind,
+            'provider':provider.state,'probe':probe.state,'key_preparation_cleanup_confirmed':preparation_clean,
+            'control_joined':not controller.is_alive(),'control_errors':control_errors}
+        (directory/'configured_observation.json').write_text(json.dumps(observation,indent=2),encoding='utf-8')
+        emit({'event':'cleanup_ack','resource_opened':probe.state['resource_opened'],'resources_closed':acknowledged})
+        os.close(protocol)
+    return 0 if status=='completed' and acknowledged else 3
+
+if __name__=='__main__':
+    try:code=main()
+    except BaseException:code=3
+    raise SystemExit(code)
diff --git a/configured_entry_gate.py b/configured_entry_gate.py
new file mode 100644
--- /dev/null
+++ b/configured_entry_gate.py
@@ -0,0 +1,167 @@
+"""Stdlib-only ingress. No product/provider import or settings read before start."""
+import json
+import math
+import os
+from pathlib import Path
+import sys
+import threading
+import time
+
+MAX_START = 4096
+MAX_OUTPUT = 16 * 1024
+FAILURE_STATUSES = frozenset({'failed', 'cancelled', 'deadline_exceeded', 'cleanup_unconfirmed',
+    'output_or_receipt_rejected', 'spawn_error', 'protocol_error', 'supervisor_error',
+    'spawn_cleanup_unconfirmed', 'receipt_failed', 'output_limit', 'output_rejected'})
+PROOF_FIELDS = ('application_ack', 'os_release_confirmed', 'completion_receipt_valid')
+FRAME_FIELDS = frozenset({'outer_run_id', 'status', 'successful', *PROOF_FIELDS})
+
+
+def _local_file(value):
+    # Shared stdlib-only lexical policy; no settings/provider/native work.
+    from configured_child import explicit_local_file
+    return explicit_local_file(value)
+
+
+def _unique_fields(pairs):
+    value = {}
+    for key, item in pairs:
+        if key in value:
+            raise ValueError('duplicate configured launch field')
+        value[key] = item
+    return value
+
+
+def _read_start(stream):
+    raw = stream.readline(MAX_START + 1)
+    if not raw or len(raw) > MAX_START or not raw.endswith(b'\n'):
+        raise ValueError('bounded configured launch required')
+    try:
+        value = json.loads(raw, object_pairs_hook=_unique_fields)
+    except (ValueError, UnicodeError):
+        raise ValueError('configured launch rejected') from None
+    required = {'op', 'settings_path', 'outer_run_id', 'deadline', 'job_handle'}
+    if (not isinstance(value, dict) or set(value) != required or value['op'] != 'start'
+            or not _local_file(value['settings_path'])
+            or type(value['outer_run_id']) is not str or len(value['outer_run_id']) != 32
+            or any(c not in '0123456789abcdef' for c in value['outer_run_id'])
+            or type(value['job_handle']) is not int or value['job_handle'] <= 0
+            or type(value['deadline']) not in (int, float) or not math.isfinite(value['deadline'])):
+        raise ValueError('configured launch rejected')
+    return value
+
+
+def _verify_job(handle):
+    # This import occurs only after the bounded private start was accepted.
+    from configured_native_owner import verify_inherited_job
+    verify_inherited_job(handle)
+
+
+def _load_entry(site_packages):
+    site = Path(site_packages)
+    if not site.is_absolute() or site.name != 'site-packages' or site.parent.name != 'Lib':
+        raise ValueError('configured runtime rejected')
+    # The base -I -S ingress avoids the venv redirector before assignment. Once
+    # trusted, every nested product worker uses the creator's approved venv.
+    venv = site.parent.parent
+    sys.executable = str(venv / 'Scripts' / 'python.exe')
+    sys.prefix = str(venv)
+    sys.path.append(str(site))
+    import schema_entry
+    return schema_entry
+
+
+def _counts(value):
+    if (not isinstance(value, dict) or set(value) != {'table_count', 'view_count'}
+            or any(type(v) is not int or not 0 <= v < 2**63 for v in value.values())):
+        raise ValueError('schema aggregate rejected')
+    return dict(value)
+
+
+def _validate_frame(value, outer_run_id):
+    if (not isinstance(value, dict) or value.get('outer_run_id') != outer_run_id
+            or type(value.get('status')) is not str
+            or type(value.get('successful')) is not bool
+            or any(type(value.get(key)) is not bool for key in PROOF_FIELDS)):
+        raise ValueError('configured gate output rejected')
+    if value['status'] == 'completed':
+        if (set(value) != FRAME_FIELDS | {'counts'} or value['successful'] is not True
+                or not all(value[key] for key in PROOF_FIELDS)):
+            raise ValueError('configured gate success rejected')
+        return _counts(value['counts'])
+    if (set(value) != FRAME_FIELDS or value['status'] not in FAILURE_STATUSES
+            or value['successful'] is not False):
+        raise ValueError('configured gate failure rejected')
+    return None
+
+
+def _watch_control(stream, cancelled, finished):
+    try:
+        descriptor = stream.fileno()
+    except (AttributeError, OSError):
+        return  # In-memory streams used by pure contract tests have no OS pipe.
+    def watch():
+        try:
+            os.read(descriptor, 1)  # Private pipe: any trailing input or EOF cancels.
+        except OSError:
+            pass
+        if not finished.is_set():
+            cancelled.set()
+    # Raw os.read holds no buffered-stdin lock at interpreter shutdown. The
+    # exact gate process owns this pipe; normal completion may exit with it idle.
+    threading.Thread(target=watch, name='configured-private-control', daemon=True).start()
+
+
+def _execute(stream, directory, site_packages):
+    start = _read_start(stream)
+    # Close the inherited query-only Job handle before any provider work.
+    _verify_job(start['job_handle'])
+    remaining = start['deadline'] - time.monotonic()
+    if not 0 < remaining <= 30:
+        raise ValueError('configured launch deadline rejected')
+    entry = _load_entry(site_packages)
+    context = {'outer_run_id': start['outer_run_id'], 'assigned_before_start': True,
+               'active_process_limit': 8}
+    cancelled, finished = threading.Event(), threading.Event()
+    _watch_control(stream, cancelled, finished)
+    try:
+        result = entry.run_configured(Path(directory) / 'entry', start['settings_path'],
+            overall=remaining, cleanup_budget=3, launch_context=context, cancel_event=cancelled)
+    finally:
+        finished.set()
+    required = {'status', 'successful', *PROOF_FIELDS}
+    known = required | {'counts', 'scope', 'adapter', 'run_id', 'runner', 'LINE_read'}
+    if not isinstance(result, dict) or not required <= set(result) <= known:
+        raise ValueError('configured inner result rejected')
+    public = {'outer_run_id': start['outer_run_id'], **{key: result[key] for key in required}}
+    if 'counts' in result:
+        public['counts'] = result['counts']
+    _validate_frame(public, start['outer_run_id'])
+    return public
+
+
+def main():
+    # Isolated -S interpreter: all imports above are stdlib. Redirect before parsing
+    # the private frame so provider prints and raw errors cannot reach public pipes.
+    protocol = os.dup(1)
+    try:
+        with open(os.devnull, 'wb') as sink:
+            os.dup2(sink.fileno(), 1)
+            os.dup2(sink.fileno(), 2)
+        if len(sys.argv) != 3:
+            return 3
+        sys.path.insert(0, str(Path(__file__).resolve().parent))
+        result = _execute(sys.stdin.buffer, sys.argv[1], sys.argv[2])
+        raw = json.dumps(result, separators=(',', ':')).encode() + b'\n'
+        if len(raw) > MAX_OUTPUT:
+            return 3
+        os.write(protocol, raw)
+        return 0 if result['successful'] else 3
+    except BaseException:
+        # Missing/invalid start or Job proof is never an application acknowledgement.
+        return 3
+    finally:
+        os.close(protocol)
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/configured_launcher.py b/configured_launcher.py
new file mode 100644
--- /dev/null
+++ b/configured_launcher.py
@@ -0,0 +1,352 @@
+"""Fixed local configured-schema launcher. No MCP registration or arbitrary argv."""
+import json
+import os
+from pathlib import Path
+import sys
+import threading
+import time
+import uuid
+
+from configured_entry_gate import _local_file, _unique_fields, _validate_frame
+
+WORK_SECONDS = 30
+CLEANUP_SECONDS = 3
+MAX_BYTES = 16 * 1024
+RETAINED = {}
+_REGISTRY_LOCK = threading.RLock()
+
+
+def _backend():
+    from configured_native_owner import Backend
+    return Backend()
+
+
+def _label(error):
+    name = type(error).__name__
+    return name if name in {'OSError', 'ValueError', 'TimeoutError', 'TimeoutExpired',
+                           'KeyboardInterrupt', 'SystemExit', 'RuntimeError'} else 'UnexpectedError'
+
+
+def _write_result(path, value):
+    raw = json.dumps(value, separators=(',', ':')).encode()
+    if len(raw) > MAX_BYTES:
+        raise ValueError('bounded launcher receipt required')
+    temporary = path.with_suffix('.tmp')
+    temporary.write_bytes(raw)
+    temporary.replace(path)
+
+
+class _Owner:
+    def __init__(self, directory, settings_path, cancel_event=None):
+        self.directory = Path(directory)
+        self.token = uuid.uuid4().hex
+        self.started = time.monotonic()
+        self.work_deadline = self.started + WORK_SECONDS
+        self.cleanup_deadline = None
+        self._cooperative_deadline = None
+        self._settings = settings_path
+        self.cancel_event = cancel_event
+        self.backend = self.job = self.child = None
+        self.assigned = self.start_sent = self.forced = False
+        self.spawn_done = threading.Event()
+        self.stop = threading.Event()
+        self.cleanup_lock = threading.RLock()
+        self.output = bytearray()
+        self.output_bytes = 0
+        self.errors = []
+        self.status = 'starting'
+        self.cleaned = False
+        self.initial_result = None
+        self.primary_interrupt = None
+        # Ownership precedes every native acquisition and fallible persistence.
+        with _REGISTRY_LOCK:
+            RETAINED[self.token] = self
+
+    def error(self, point, error):
+        if len(self.errors) < 16:
+            self.errors.append({'operation': point, 'type': _label(error)})
+        if isinstance(error, (KeyboardInterrupt, SystemExit)) and self.primary_interrupt is None:
+            self.primary_interrupt = error
+
+    def _register_job(self, job):
+        self.job = job
+
+    def _register_child(self, child):
+        self.child = child
+
+    def _allowed(self):
+        return (not self.stop.is_set() and not self._cancelled()
+                and time.monotonic() < self.work_deadline)
+
+    def _cancelled(self):
+        event = getattr(self, 'cancel_event', None)
+        return event is not None and event.is_set()
+
+    def _spawn(self):
+        try:
+            if not self._allowed():
+                return
+            self.backend = _backend()
+            self.job = self.backend.new_job(self._register_job)
+            self.job.configure()
+            if self.job.policy() != {'kill_on_close': True, 'active_process_limit': 8}:
+                raise OSError('configured Job policy rejected')
+            if not self._allowed():
+                return
+            inherited = self.job.inherit()
+            argv = [sys._base_executable, '-I', '-S', '-B',
+                    str(Path(__file__).with_name('configured_entry_gate.py')),
+                    str(self.directory), str(Path(sys.prefix) / 'Lib' / 'site-packages')]
+            self.child = self.backend.spawn(argv, (inherited,), self._register_child)
+            self.job.close_inherited()
+            if not self._allowed():
+                return  # A late child stays suspended and receives no private start.
+            if self.child.resumed:
+                raise OSError('configured child was not suspended')
+            self.job.assign(self.child)
+            self.assigned = True
+            if not self.job.member(self.child):
+                raise OSError('exact configured membership rejected')
+            if self.job.policy() != {'kill_on_close': True, 'active_process_limit': 8}:
+                raise OSError('configured Job policy changed')
+            if not self._allowed():
+                return
+            self.child.resume()
+            if not self._allowed():
+                return
+            payload = (json.dumps({'op': 'start', 'settings_path': self._settings,
+                'outer_run_id': self.token, 'deadline': self.work_deadline,
+                'job_handle': inherited}, separators=(',', ':')) + '\n').encode()
+            if len(payload) > 4096:
+                raise ValueError('bounded configured launch required')
+            # CPython Event.set uses this same condition. Serialize cancellation
+            # with the private start commit, instead of a check/write race.
+            condition = self.cancel_event._cond if self.cancel_event is not None else None
+            if condition is not None and not condition.acquire(timeout=max(0, self.work_deadline-time.monotonic())):
+                self.status = 'deadline_exceeded'
+                return
+            try:
+                if not self._allowed():
+                    return
+                self.child.stdin.write(payload)
+                self.child.stdin.flush()
+                self.start_sent = True
+                self.status = 'running'
+            finally:
+                if condition is not None:condition.release()
+        except BaseException as error:
+            self.status = 'spawn_error'
+            self.error('spawn', error)
+        finally:
+            self._settings = None
+            self.spawn_done.set()
+            if self.stop.is_set() and self.cleanup_deadline is not None:
+                self.cleanup(self.cleanup_deadline)
+
+    def pump(self):
+        if self.child is None or self.backend is None:
+            return
+        for label in ('stdout', 'stderr'):
+            for _ in range(4):
+                raw = self.backend.read_available(self.child, label, 4096)
+                if not raw:
+                    break
+                self.output_bytes += len(raw)
+                if self.output_bytes > MAX_BYTES:
+                    self.status = 'output_limit'
+                    self.stop.set()
+                    return
+                if label == 'stdout':
+                    self.output.extend(raw)
+                else:
+                    self.status = 'output_rejected'
+                    self.stop.set()
+
+    def supervise(self):
+        while True:
+            self.pump()
+            if self.stop.is_set():
+                return
+            if self._cancelled():
+                self.status = 'cancelled'
+                return
+            if self.spawn_done.is_set():
+                if self.child is None or self.status == 'spawn_error':
+                    return
+            if time.monotonic() >= self.work_deadline:
+                self.status = 'deadline_exceeded'
+                return
+            if self.spawn_done.is_set():
+                if self.child.poll() is not None:
+                    self.pump()
+                    # Polling or the final drain may cross the work deadline.
+                    # An output rejection keeps its already recorded cause.
+                    if not self.stop.is_set() and time.monotonic() >= self.work_deadline:
+                        self.status = 'deadline_exceeded'
+                    if self._cancelled():
+                        self.status = 'cancelled'
+                    return
+            time.sleep(0.005)
+
+    def _active(self):
+        return self.job.active() if self.job is not None else 0
+
+    def cleanup(self, deadline):
+        self.stop.set()
+        if not self.cleanup_lock.acquire(timeout=max(0, deadline - time.monotonic())):
+            return False
+        try:
+            if self.cleaned:
+                return True
+            if self._cooperative_deadline is None:
+                # One cooperative window per owner, clipped by this cleanup's
+                # absolute deadline. Exact retries cannot renew the allowance.
+                self._cooperative_deadline = min(deadline, time.monotonic() + 1)
+            terminated = False
+            while True:
+                child = self.child
+                if child is not None:
+                    try:
+                        if child.stdin is not None and not child.stdin.closed:
+                            child.stdin.close()  # EOF is the cooperative request.
+                        self.pump()
+                    except BaseException as error:
+                        self.error('cleanup_io', error)
+                try:
+                    done = child is None or child._handle is None or child.poll() is not None
+                    active = self._active()
+                except BaseException as error:
+                    self.error('cleanup_poll', error)
+                    done, active = False, None
+                if self.spawn_done.is_set() and done and active == 0:
+                    break
+                now = time.monotonic()
+                cooperative = (self.assigned and self.start_sent
+                               and now < self._cooperative_deadline)
+                # An unstarted creation stays suspended and is cleaned at once.
+                # Only started, assigned descendants may finish after EOF.
+                if not terminated and not cooperative:
+                    try:
+                        if self.assigned and self.job is not None:
+                            self.job.terminate()
+                            terminated = True
+                            self.forced = True
+                        elif child is not None and child._handle is not None and not done:
+                            child.kill()
+                            terminated = True
+                            self.forced = True
+                    except BaseException as error:
+                        self.error('terminate', error)
+                if time.monotonic() >= deadline:
+                    return False
+                wait_until = min(deadline, self._cooperative_deadline) if cooperative else deadline
+                time.sleep(min(0.005, max(0, wait_until - time.monotonic())))
+            # Creation has ceased; these exact handles are no longer used by spawn.
+            if child is not None:
+                if child._handle is not None:
+                    child.wait(timeout=max(0, deadline - time.monotonic()))
+                for name in ('stdin', 'stdout', 'stderr'):
+                    stream = getattr(child, name)
+                    if stream is not None and not stream.closed:
+                        stream.close()
+                if not self.backend.close_startup(child):
+                    return False
+                for handle in (child._thread, child._handle):
+                    if handle is not None and not handle.closed:
+                        handle.Close()
+            if self.job is not None:
+                self.job.close()
+            self.cleaned = True
+            with _REGISTRY_LOCK:
+                RETAINED.pop(self.token, None)
+            return True
+        except BaseException as error:
+            self.error('cleanup', error)
+            return False
+        finally:
+            self.cleanup_lock.release()
