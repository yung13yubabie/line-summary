[run]
source =
    db_reader
    key_extractor
    line_mcp_server
    safety
# Measure shipping runtime only; exclude local tools and test code.
branch = True
omit =
    spike/*
    tests/*
    tools/*

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
show_missing = True
# Offline coverage threshold; this does not validate live LINE access.
fail_under = 85
