[run]
source =
    db_reader
    key_extractor
    line_mcp_server
    safety
    plugin_adapter
    plugin_runtime
    mock_privacy
# Coverage target is the shipping runtime only. spike/ is a one-off reverse-
# engineering harness (its "test" is running it against live LINE), tools/ is
# an interactive real-mouse-automation script not unit-testable in CI, and
# tests/ should not measure themselves.
branch = True
omit =
    spike/*
    tests/*
    tools/*

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
show_missing = True
# Enforced floor for the clean-clone (offline) suite. The memory-scan path in
# key_extractor is not validated against real LINE by this suite; this floor
# guards the reproducible synthetic baseline without claiming live coverage.
fail_under = 85
